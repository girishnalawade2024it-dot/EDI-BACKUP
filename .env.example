# ============================================================
# Campus Resource Booking System — Environment Configuration Example
# Copy this file to .env and insert your actual credentials:
#   copy .env.example .env
# ============================================================

# ── Groq Cloud Console AI Configuration ──
# Generate your key at: https://console.groq.com/keys
# Required for AI Strategic Utilisation Reports & Bottleneck Analysis
GROQ_API_KEY=gsk_your_groq_api_key_here

# Default Groq model to use for utilisation insights
# Options: llama-3.1-8b-instant, openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.6-27b, deepseek-r1-distill-llama-70b
GROQ_MODEL=llama-3.1-8b-instant

# ── Supabase Configuration (Cloud Database) ──
# If unconfigured or prefixed with YOUR_, system uses local SQLite/localStorage engine
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# ── Server Configuration ──
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development
